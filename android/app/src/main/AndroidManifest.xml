<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The keyboard asks for no permission at all: no network, no microphone
         (android/docs/feature-spec.md). androidx.core adds one for receivers registered as not
         exported; the keyboard registers none, so it is taken out again. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <!-- The keyboard's own permission, which guards the personal words' provider below. Only the
         owner's hub app gets it: a signature permission, granted to the hub, which is signed with
         another key, by that key's certificate digest (knownSigner, Android 12 and later). -->
    <permission
        android:name="com.xern.xrnkey.permission.SYNC_WORDS"
        android:knownCerts="@array/hub_certs"
        android:protectionLevel="signature|knownSigner"
        tools:targetApi="s" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Direct-boot aware: it types before the phone's first unlock, with the shipped models. -->
        <service
            android:name=".ime.XrnkeyService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- The personal words for the hub app's sync, while Settings has it on (sync/WordsProvider.kt). -->
        <provider
            android:name=".sync.WordsProvider"
            android:authorities="com.xern.xrnkey.words"
            android:exported="true"
            android:permission="com.xern.xrnkey.permission.SYNC_WORDS" />

        <!-- The clipboard history's images, for the field they are pasted into: not exported, each
             URI readable only by the app it is given to (commitContent's grant). -->
        <provider
            android:name=".clip.ClipImageProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_images" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
